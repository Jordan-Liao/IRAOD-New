"""Rotated Deformable DETR with explicit matched-query features for VLST.

The native multiscale transformer keeps 4-D reference-box refinement. An
independent angle branch on every decoder layer predicts le90 rotations.
Matching and losses use true pixel-space rotated IoU, including non-square
images. This is a basic rotated extension, not ARS-DETR/RHINO attention.
"""
import math
import torch
from torch import nn
from torch.nn import functional as F
from scipy.optimize import linear_sum_assignment
from mmcv.ops import box_iou_rotated
from mmcv.runner import force_fp32
from mmdet.core import reduce_mean
from mmdet.models.dense_heads import DeformableDETRHead
from mmdet.models.utils.transformer import inverse_sigmoid
from mmrotate.models.builder import ROTATED_HEADS
from .geometry import canonicalize, scale_factors


@ROTATED_HEADS.register_module()
class OrthoRotatedDETRHead(DeformableDETRHead):
    def __init__(self, *args, angle_loss_weight=1., angle_cost_weight=1., **kwargs):
        if kwargs.get('as_two_stage', False):
            raise ValueError('This rotated head uses learned queries (as_two_stage=False)')
        self.angle_loss_weight = float(angle_loss_weight)
        self.angle_cost_weight = float(angle_cost_weight)
        super().__init__(*args, **kwargs)
        if not self.loss_cls.use_sigmoid:
            raise ValueError('OrthoRotatedDETRHead requires sigmoid focal classification')

    def _init_layers(self):
        super()._init_layers()
        self.angle_branches = nn.ModuleList([
            nn.Linear(self.embed_dims, 1)
            for _ in range(self.transformer.decoder.num_layers)])

    def init_weights(self):
        super().init_weights()
        for branch in self.angle_branches:
            nn.init.zeros_(branch.weight)
            nn.init.zeros_(branch.bias)

    def forward(self, mlvl_feats, img_metas):
        return self.forward_with_queries(mlvl_feats, img_metas)[0]

    def forward_with_queries(self, mlvl_feats, img_metas):
        bs = mlvl_feats[0].size(0)
        h, w = img_metas[0]['batch_input_shape']
        masks = mlvl_feats[0].new_ones((bs, h, w))
        for i, meta in enumerate(img_metas):
            masks[i, :meta['img_shape'][0], :meta['img_shape'][1]] = 0
        level_masks = [F.interpolate(masks[None], size=f.shape[-2:]).bool().squeeze(0)
                       for f in mlvl_feats]
        positions = [self.positional_encoding(m) for m in level_masks]
        hs, initial, intermediate, _, _ = self.transformer(
            mlvl_feats, level_masks, self.query_embedding.weight, positions,
            reg_branches=self.reg_branches if self.with_box_refine else None,
            cls_branches=None)
        hs = hs.permute(0, 2, 1, 3)  # layers, batch, queries, embedding
        classes, boxes = [], []
        for layer in range(hs.shape[0]):
            ref = inverse_sigmoid(initial if layer == 0 else intermediate[layer - 1])
            xywh = self.reg_branches[layer](hs[layer])
            if ref.shape[-1] == 4:
                xywh = xywh + ref
            else:
                xywh = torch.cat((xywh[..., :2] + ref, xywh[..., 2:]), -1)
            angle = (self.angle_branches[layer](hs[layer]).sigmoid() - .5) * math.pi
            boxes.append(torch.cat((xywh.sigmoid(), angle), -1))
            classes.append(self.cls_branches[layer](hs[layer]))
        return (torch.stack(classes), torch.stack(boxes), None, None), hs

    @staticmethod
    def pixel_boxes(predictions, meta):
        h, w = meta['img_shape'][:2]
        return canonicalize(predictions * predictions.new_tensor([w, h, w, h, 1.]))

    @torch.no_grad()
    def match(self, logits, predictions, boxes, labels, meta):
        if len(boxes) > predictions.shape[0]:
            raise ValueError('More targets than object queries; increase num_query')
        if not len(boxes):
            empty = labels.new_empty((0,), dtype=torch.long)
            return empty, empty
        pred = self.pixel_boxes(predictions.float(), meta)
        target = canonicalize(boxes.float())
        h, w = meta['img_shape'][:2]
        factor = pred.new_tensor([w, h, w, h])
        cls_cost = self.assigner.cls_cost(logits.float(), labels)
        l1 = torch.cdist(pred[:, :4] / factor, target[:, :4] / factor, p=1)
        angle = 1 - torch.cos(2 * (pred[:, None, 4] - target[None, :, 4]))
        overlap = box_iou_rotated(pred.contiguous(), target.contiguous())
        cost = (cls_cost + self.loss_bbox.loss_weight * l1
                + self.angle_cost_weight * angle - self.loss_iou.loss_weight * overlap)
        if not torch.isfinite(cost).all():
            raise FloatingPointError('Non-finite rotated Hungarian cost')
        row, col = linear_sum_assignment(cost.cpu().numpy())
        return (torch.as_tensor(row, device=labels.device, dtype=torch.long),
                torch.as_tensor(col, device=labels.device, dtype=torch.long))

    def _layer_loss(self, logits, predictions, gt_boxes, gt_labels, metas, regression):
        pairs = [self.match(c, b, g, l, m) for c, b, g, l, m in
                 zip(logits, predictions, gt_boxes, gt_labels, metas)]
        labels = torch.full(logits.shape[:2], self.num_classes,
                            dtype=torch.long, device=logits.device)
        for i, (rows, cols) in enumerate(pairs):
            labels[i, rows] = gt_labels[i][cols]
        positives = sum(len(p[0]) for p in pairs)
        avg = reduce_mean(logits.new_tensor(float(positives))).clamp(min=1).item()
        cls = self.loss_cls(logits.reshape(-1, self.cls_out_channels),
                            labels.reshape(-1), avg_factor=avg)
        zero = predictions.sum() * 0.
        l1 = iou = angle = zero
        if regression and positives:
            predicted, targets, factors = [], [], []
            for p, g, meta, (rows, cols) in zip(predictions, gt_boxes, metas, pairs):
                predicted.append(self.pixel_boxes(p[rows], meta))
                targets.append(canonicalize(g[cols]))
                h, w = meta['img_shape'][:2]
                factors.append(p.new_tensor([w, h, w, h]).expand(len(rows), 4))
            p, g, factors = torch.cat(predicted), torch.cat(targets), torch.cat(factors)
            l1 = self.loss_bbox(p[:, :4] / factors, g[:, :4] / factors, avg_factor=avg)
            iou = self.loss_iou(p.contiguous(), g.contiguous(), avg_factor=avg)
            angle = (1 - torch.cos(2 * (p[:, 4] - g[:, 4]))).sum() / avg * self.angle_loss_weight
        return dict(loss_cls=cls, loss_bbox=l1, loss_iou=iou, loss_angle=angle), pairs

    @force_fp32(apply_to=('all_cls_scores', 'all_bbox_preds'))
    def loss_with_matches(self, all_cls_scores, all_bbox_preds, enc_cls_scores,
                          enc_bbox_preds, gt_bboxes_list, gt_labels_list,
                          img_metas, gt_bboxes_ignore=None, regression=True):
        if gt_bboxes_ignore is not None and any(len(x) for x in gt_bboxes_ignore if x is not None):
            raise NotImplementedError('Ignored OBB targets are not supported')
        losses = {}
        last_pairs = None
        for i, (cls, boxes) in enumerate(zip(all_cls_scores, all_bbox_preds)):
            layer, last_pairs = self._layer_loss(
                cls, boxes, gt_bboxes_list, gt_labels_list, img_metas, regression)
            prefix = '' if i == len(all_cls_scores) - 1 else f'd{i}.'
            losses.update({prefix + key: value for key, value in layer.items()})
        return losses, last_pairs

    def loss(self, *args, **kwargs):
        return self.loss_with_matches(*args, **kwargs)[0]

    @force_fp32(apply_to=('all_cls_scores', 'all_bbox_preds'))
    def get_bboxes(self, all_cls_scores, all_bbox_preds, enc_cls_scores,
                   enc_bbox_preds, img_metas, rescale=False):
        results = []
        for logits, pred, meta in zip(all_cls_scores[-1], all_bbox_preds[-1], img_metas):
            # One class per query prevents the same query being copied into
            # contradictory class pseudo labels. DETR inference uses no NMS.
            scores, labels = logits.sigmoid().max(-1)
            limit = min(int(self.test_cfg.get('max_per_img', self.num_query)), len(scores))
            scores, ids = scores.topk(limit)
            labels = labels[ids]
            boxes = self.pixel_boxes(pred[ids], meta)
            if rescale:
                boxes = boxes / scale_factors(meta, boxes)
            threshold = float(self.test_cfg.get('score_thr', 0.))
            keep = scores >= threshold
            results.append((torch.cat((boxes[keep], scores[keep, None]), -1), labels[keep]))
        return results
